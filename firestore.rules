rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default fallback: deny all read/write
    match /{document=**} {
      allow read, write: if false;
    }

    // Accounts collection
    match /accounts/{email} {
      allow read, write: if true;
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Tokens collection
    match /tokens/{token} {
      allow read, write: if true;
    }
  }
}
